<odoo>
    <record id="group_finance_manager" model="res.groups">
        <field name="name">VendorGuard / Finance Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="vendorguard_fraud_flag_company_rule" model="ir.rule">
        <field name="name">VendorGuard Fraud Flag: multi-company</field>
        <field name="model_id" ref="model_vendorguard_fraud_flag"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
