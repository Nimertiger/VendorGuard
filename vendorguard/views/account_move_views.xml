<odoo>
    <record id="account_move_view_form_inherit_vendorguard" model="ir.ui.view">
        <field name="name">account.move.form.inherit.vendorguard</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']" position="after">
                <page string="Fraud Flags" name="vendorguard_fraud_flags">
                    <field name="fraud_flag_ids" readonly="1">
                        <list decoration-danger="severity in ('critical','high')"
                              decoration-warning="severity == 'medium'">
                            <field name="create_date"/>
                            <field name="flag_type"/>
                            <field name="severity"/>
                            <field name="amount"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
